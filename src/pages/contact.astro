---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FORMSPREE_ENDPOINT, CONTACT_LINKS } from '../config/contact';
---

<BaseLayout title="Contact — Angel Cobo" description="Get in touch.">
  <h1>Contact</h1>
  <p>
    If you're reaching out about a role, a collaboration, or press, the form
    below is the fastest way to get my attention.
  </p>

  <form action={FORMSPREE_ENDPOINT} method="POST">
    <!-- Honeypot: real users never see or fill this in; bots often do. -->
    <div class="honeypot-field" aria-hidden="true">
      <label for="_gotcha">Leave this field empty</label>
      <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <div class="field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required />
    </div>

    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required />
    </div>

    <div class="field">
      <label for="category">Category</label>
      <select id="category" name="category" required>
        <option value="" disabled selected>Select one...</option>
        <option value="Employment opportunity">Employment opportunity</option>
        <option value="Collaboration">Collaboration</option>
        <option value="Media or press">Media or press</option>
        <option value="Other">Other</option>
      </select>
    </div>

    <div class="field">
      <label for="message">Tell me about your interest</label>
      <textarea id="message" name="message" required></textarea>
    </div>

    <button type="submit">Send</button>
  </form>

  <h2>Elsewhere</h2>
  <ul class="contact-links">
    {
      CONTACT_LINKS.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
